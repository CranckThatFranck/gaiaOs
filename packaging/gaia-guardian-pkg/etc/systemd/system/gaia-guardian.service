[Unit]
Description=Gaia Guardian C Daemon (Ultra-low RAM Telemetry, Anti-Freeze & Gemini 3.8 Flash Advisor)
After=local-fs.target network.target

[Service]
Type=simple
EnvironmentFile=-/etc/gaiaos/guardian.env
ExecStart=/usr/local/bin/gaia-guardian
ExecReload=/bin/kill -USR1 $MAINPID
Restart=always
RestartSec=3
MemoryHigh=12M
MemoryMax=24M

[Install]
WantedBy=multi-user.target
